# Archon per-codebase secrets
.archon/config.yaml

# Pi agent runtime artifacts — created by the kimi-coding provider during a
# run. These are transient and must never be committed; benchmark workflows do
# `git add -A`, which would otherwise sweep them into the diff (and only in
# Kimi-using cells, biasing scope comparisons).
.pi-loop.json
.pi-loop.json.lock
*.lock.json

# Claude Code / Archon scheduled-task lock — written by the harness during a
# session; transient and must never be committed.
.claude/scheduled_tasks.lock

# Local benchmark logs + scratch issue bodies (never part of a PR)
.benchmark-logs/

# Runtime deploy state — rewritten by deploy.sh on every blue/green flip,
# so keeping it tracked makes every host-side `git pull` abort with a dirty
# working tree. The bootstrap path in deploy.sh writes the initial value
# (`reverse_proxy app-blue:8000`) when the file is absent; the
# upstream.conf.example next to it is the human-readable reference shape.
deploy/upstream.conf
