# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Database
*.db
*.sqlite
*.sqlite3

# Node
node_modules/

# Environment
.env
*.env
.env.*
# ...but the templates are the documentation, so they stay tracked. Without
# this negation a fresh `.env.example` in a new directory is silently ignored.
!.env.example
!**/.env.example

# Key material — nothing in this repo should ever hold one, and a stray copy
# next to the deploy scripts would otherwise be swept up by `git add -A`.
*.pem
*.key
id_rsa*

# Logs
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test screenshots
app/screenshots/test-*

# Archon per-codebase secrets
.archon/config.yaml

# Workflow run artifacts — $ARTIFACTS_DIR is where agents write plan.md,
# investigation.md, screenshots and raw command output during a run. Same
# exposure path as the config.yaml incident: several workflows do `git add -A`,
# which committed .archon/artifacts/fix-report-pr-67.md by accident.
.archon/artifacts/

# Pi agent runtime artifacts — created by the kimi-coding provider during a
# run. These are transient and must never be committed; benchmark workflows do
# `git add -A`, which would otherwise sweep them into the diff (and only in
# Kimi-using cells, biasing scope comparisons).
.pi-loop.json
.pi-loop.json.lock
*.lock.json

# Local benchmark logs + scratch issue bodies (never part of a PR)
.benchmark-logs/

# Runtime deploy state — rewritten by deploy.sh on every blue/green flip,
# so keeping it tracked makes every host-side `git pull` abort with a dirty
# working tree. The bootstrap path in deploy.sh writes the initial value
# (`reverse_proxy app-blue:8000`) when the file is absent; the
# upstream.conf.example next to it is the human-readable reference shape.
deploy/upstream.conf
